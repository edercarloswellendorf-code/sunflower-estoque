# Railway injeta DATABASE_URL automaticamente ao adicionar um PostgreSQL ao projeto
DATABASE_URL="postgresql://usuario:senha@localhost:5432/sunflower_estoque"

# Porta da API (Railway define PORT automaticamente em produção)
PORT=3001

# URL(s) do frontend autorizadas a chamar a API (separadas por vírgula)
FRONTEND_URL="http://localhost:3000"
